<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over src/main's manifest in the VR build (configure.py with the vr option):
     an OpenXR app for standalone headsets: the Meta Quest, the Steam Frame and (Test72) PICO.

     The launcher (the disc image picker) stays an ordinary 2D activity, which
     the Quest shows on a panel; the game's activity is the immersive one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <!-- the Khronos loader (libopenxr_loader.so) finds the runtime through
         its broker or the system's active_runtime.json -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application>
        <!-- the Quest headsets the app is offered on -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest|quest2|questpro|quest3|quest3s" />
        <!-- Test72: PICO (pull request #4, adapted). pvr.app.type=vr is PICO's
             documented key for a VR app. The two input keys are the PR's
             finding on PICO OS 5 (a controller-only app, so the system's hand
             tracking dialog stays away); unverified here, ignored elsewhere. -->
        <meta-data
            android:name="pvr.app.type"
            android:value="vr" />
        <meta-data
            android:name="pvr.app.inputType"
            android:value="controller" />
        <meta-data
            android:name="pvr.app.handtrackingSupport"
            android:value="0" />

        <!-- the game, immersive. Its own process: the game ends its process
             when it quits (host_exit), which leaves the launcher's alone, and
             the headset switches from the launcher's panel to VR cleanly. -->
        <activity
            android:name=".HaloActivity"
            android:process=":halo_game"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            tools:replace="android:exported,android:launchMode">
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="com.picovr.intent.category.VR" />
                <category android:name="com.htc.intent.category.VRAPP" />
            </intent-filter>
        </activity>

        <!-- Test73: the same game in the app's main process, which the Steam Frame's Lepton watches (it ends
             the container when that process ends): the launcher starts this one there (Lepton.java). Not
             exported and no intent filter, so no headset lists it. -->
        <activity
            android:name=".HaloFrameActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <meta-data
                android:name="android.app.category"
                android:value="game" />
        </activity>
    </application>
</manifest>
